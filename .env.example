# Copy to .env and adjust. Every value has a default; .env is never committed.

# --- Ingestion (M1) ---
# DATA_DIR=./data
# HTTP_USER_AGENT=vnlaw-rag/0.1 (educational research project)
# HTTP_DELAY_SECONDS=1.0
# CHUNK_MAX_TOKENS=1200
# TOKENIZER_NAME=BAAI/bge-m3

# --- Index and retrieval (M2) ---
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and the Docker port
# is bound to IPv4 only, which adds a connection timeout to every new connection.
# DATABASE_URL=postgresql://vnlaw:vnlaw@127.0.0.1:5442/vnlaw
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_REVISION=9a0624b896d81da7492a910ffa53731274b6cf3d   # safetensors conversion, pinned
# RETRIEVAL_VECTOR_K=20
# RETRIEVAL_KEYWORD_K=20
# RETRIEVAL_TOP_K=8
# RRF_K=60

# --- LLM (M3, Google Gemini API; not read yet) ---
GEMINI_API_KEY=
LLM_MODEL=
