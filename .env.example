# Copy to .env and adjust. Every value has a default; .env is never committed.

# --- Ingestion (M1) ---
# DATA_DIR=./data
# HTTP_USER_AGENT=vnlaw-rag/0.1 (educational research project)
# HTTP_DELAY_SECONDS=1.0
# CHUNK_MAX_TOKENS=1200
# TOKENIZER_NAME=BAAI/bge-m3

# --- Index and retrieval (M2) ---
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and the Docker port
# is bound to IPv4 only, which adds a connection timeout to every new connection.
# DATABASE_URL=postgresql://vnlaw:vnlaw@127.0.0.1:5442/vnlaw
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_REVISION=9a0624b896d81da7492a910ffa53731274b6cf3d   # safetensors conversion, pinned
# RETRIEVAL_VECTOR_K=20
# RETRIEVAL_KEYWORD_K=20
# RETRIEVAL_TOP_K=8
# RRF_K=60

# --- LLM (M3, Google Gemini API, free tier) ---
# Create a key in Google AI Studio. Never commit .env. On the free tier Google may use the
# requests to improve its products: send only public legal text and demo questions.
GEMINI_API_KEY=
# LLM_MODEL=gemini-4-hydrogen            # checked 2026-11-24, see docs/decisions/007
# LLM_FALLBACK_MODEL=gemini-3.8-flash     # empty to disable the fallback
# LLM_THINKING_LEVEL=low                  # minimal | low | medium | high
# LLM_TIMEOUT_SECONDS=25                  # hard limit per call
# LLM_DEADLINE_SECONDS=60                 # budget per answer (fallback included)
# LLM_MAX_SOURCES=6
# GRADE_MIN_SCORE=0.55                    # below this cosine similarity: "not found"
